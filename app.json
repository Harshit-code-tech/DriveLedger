{
  "expo": {
    "name": "DriveLedger",
    "slug": "DriveLedger",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "driveledger",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.driveledger.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#084CB4",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "add_fuel",
              "title": "Log Fuel",
              "subtitle": "Quick entry",
              "icon": "symbol:fuelpump.fill",
              "params": { "href": "/add-fuel" }
            },
            {
              "id": "add_expense",
              "title": "Log Expense",
              "subtitle": "Quick entry",
              "icon": "symbol:creditcard.fill",
              "params": { "href": "/add-expense" }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73b4dc59-7bb5-4ad4-b9e5-c27f4c52acea"
      }
    }
  }
}