{
  "expo": {
    "name": "DriveLedger",
    "slug": "DriveLedger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "driveledger",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.driveledger.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#084CB4",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#084CB4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DriveLedger to record your vehicle trip distance offline.",
          "locationAlwaysAndWhenInUsePermission": "Allow DriveLedger to record your vehicle trip route and distance in the background while your screen is locked or another app is open.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_fuel": "./assets/images/shortcuts/shortcut-fuel.png",
            "shortcut_expense": "./assets/images/shortcuts/shortcut-expense.png",
            "shortcut_service": "./assets/images/shortcuts/shortcut-service.png",
            "shortcut_checklist": "./assets/images/shortcuts/shortcut-checklist.png"
          },
          "iosActions": [
            {
              "id": "add_fuel",
              "title": "Log Fuel",
              "subtitle": "Quick entry",
              "icon": "symbol:fuelpump.fill",
              "params": {
                "href": "/add-fuel"
              }
            },
            {
              "id": "add_expense",
              "title": "Log Expense",
              "subtitle": "Quick entry",
              "icon": "symbol:creditcard.fill",
              "params": {
                "href": "/add-expense"
              }
            },
            {
              "id": "add_service",
              "title": "Log Service",
              "subtitle": "Maintenance & repairs",
              "icon": "symbol:wrench.and.screwdriver.fill",
              "params": {
                "href": "/add-service"
              }
            },
            {
              "id": "trip_checklist",
              "title": "Trip Checklist",
              "subtitle": "Highway readiness",
              "icon": "symbol:checklist",
              "params": {
                "href": "/checklist"
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "VehicleGlanceWidget",
              "label": "DriveLedger Quick Glance",
              "description": "At-a-glance odometer, fuel efficiency, service alert & quick actions",
              "minWidth": "320dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widgets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "GpsTripWidget",
              "label": "DriveLedger GPS Tracker",
              "description": "Live GPS trip status, distance & quick controls",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widgets/widget-preview.png",
              "updatePeriodMillis": 900000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73b4dc59-7bb5-4ad4-b9e5-c27f4c52acea"
      }
    }
  }
}